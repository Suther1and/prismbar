{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrismBar",
  "version": "3.3.1",
  "identifier": "com.prismbar.shell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "taskbar",
        "title": "PrismBar",
        "url": "index.html?view=taskbar",
        "width": 640,
        "height": 83,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "taskbar-secondary",
        "title": "PrismBar Secondary",
        "url": "index.html?view=taskbar&monitor=secondary",
        "width": 200,
        "height": 83,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "start",
        "title": "PrismBar Start",
        "url": "index.html?view=start",
        "width": 1188,
        "height": 728,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "flyout",
        "title": "PrismBar Flyout",
        "url": "index.html?view=flyout",
        "width": 360,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "dragDropEnabled": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4NTQ4RDE2N0Q3NTQyMDcKUldRSFFuVjlGbzFVV0w5VUsxb01LRktIa2JTTUpuVkZxeXl1SFhENVdUUzF6MGo0eVd2QXBVdGEK",
      "endpoints": [
        "https://github.com/Suther1and/prismbar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
