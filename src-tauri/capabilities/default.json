{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for PrismBar multi-window shell",
  "windows": ["taskbar", "taskbar-secondary", "start", "flyout"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "updater:default"
  ]
}
